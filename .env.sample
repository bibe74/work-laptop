# Environment Configuration Sample
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control

# Client Information
# The name/identifier of the client you're working for
CLIENT_NAME=CLIENT

# VPN Configuration
# The name of the client's VPN connection
VPN_NAME=Client VPN

# Active Directory Domain Configuration
# Example: client.local (replace with actual domain name)
DOMAIN_NAME=client.local

# Active Directory Username
# Example: user1729 (your domain username without domain prefix)
DOMAIN_USER=user1729

# Full domain login format will be: DOMAIN_NAME\DOMAIN_USER
# For example: client.local\user1729 or CLIENT\user1729
